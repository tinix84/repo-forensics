{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tinix84/repo-forensics/blob/main/src/repo_forensics/schemas/evidence.schema.json",
  "title": "repo-forensics evidence item (one JSON object per line of evidence.jsonl)",
  "type": "object",
  "required": [
    "id",
    "phase",
    "kind",
    "claim",
    "status",
    "confidence",
    "evidence",
    "counter_evidence",
    "tool",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EV-[0-9]{4,}$"
    },
    "phase": {
      "enum": [
        "acquire",
        "fingerprint",
        "measure",
        "decompose",
        "infer",
        "toolchain",
        "dynamic",
        "fusion"
      ]
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "CONFIRMED",
        "SUPPORTED",
        "INFERRED",
        "UNKNOWN"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "counter_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "tool": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "confidence": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "CONFIRMED",
              "SUPPORTED",
              "INFERRED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "confidence": {
            "type": "number"
          }
        }
      }
    }
  ],
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "symbol": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}